# Copy this file to ".env" and fill in your own values.

# Supabase PostgreSQL connection string (Supabase -> Project Settings -> Database)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Cloudflare R2 (payment screenshots & QR uploads). Leave blank to use local uploads/ fallback.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# Brevo SMTP API key (signup / password reset / broadcast emails). Leave blank in dev to rely on DEBUG console OTPs.
BREVO_API_KEY=""
FROM_EMAIL="iec2025049@iiita.ac.in"

# Set to "true" ONLY in local development: prints OTP codes to the backend console.
# Never enable in production (e.g. Render) — OTP codes must never appear in logs.
DEBUG="false"

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""

# Google OAuth client ID (from Google Cloud Console). Required for Google sign-up / sign-in.
# The OAuth consent screen must be configured for the iiita.ac.in domain.
GOOGLE_CLIENT_ID=""
