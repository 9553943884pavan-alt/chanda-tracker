# Copy this file to ".env" and fill in your own values.

# Supabase PostgreSQL connection string (Supabase -> Project Settings -> Database)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Cloudflare R2 (payment screenshots & QR uploads). Leave blank to use local uploads/ fallback.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# Brevo SMTP API key (signup / password reset / broadcast emails). Leave blank to log OTPs to console instead.
BREVO_API_KEY=""
FROM_EMAIL="iec2025049@iiita.ac.in"

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
